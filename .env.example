# Set these in Vercel → Project → Settings → Environment Variables. Never commit real values.

# Supabase (Project Settings → API)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=            # public; sent to the browser for sign-in
SUPABASE_SERVICE_ROLE_KEY=    # secret; server only

# Claude
ANTHROPIC_API_KEY=
# Optional model overrides (defaults: router claude-haiku-5-5, worker claude-sonnet-5-5, planner claude-opus-5-5)
SIXXAB_MODEL_ROUTER=
SIXXAB_MODEL_WORKER=
SIXXAB_MODEL_PLANNER=

# Automations: approved actions (posts, messages, campaigns, spend) are handed to this n8n webhook.
# Without it, actions are recorded in the audit log but nothing is sent. Setup: docs/n8n-setup.md
# N8N_WEBHOOK_SECRET must match the Header Auth credential (name x-sixxab-secret) on the n8n webhook node.
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# Website
BOOKING_URL=https://calendar.app.google/YOUR-BOOKING-PAGE
CONTACT_EMAIL=sunil.kattikar@gmail.com

# Vercel Cron protection for /api/cron-briefing (any long random string)
CRON_SECRET=

# Cost guard: goals per company per 24 hours
DAILY_GOAL_LIMIT=50
# Admins (comma-separated emails) assign each business its own n8n workflow path; an admin's own
# business uses the default path in N8N_WEBHOOK_URL. Other businesses without a path are never sent.
ADMIN_EMAILS=
# Rupees per US dollar for SIXXAB stage gates of INR businesses (default 85).
INR_PER_USD=85

# Apollo.io API key for the admin Lead Finder (server only; search is free, revealing an email costs 1 credit)
APOLLO_API_KEY=
