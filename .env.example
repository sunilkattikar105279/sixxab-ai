# Set these in Vercel → Project → Settings → Environment Variables. Never commit real values.

# Supabase (Project Settings → API)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=            # public; sent to the browser for sign-in
SUPABASE_SERVICE_ROLE_KEY=    # secret; server only

# Claude
ANTHROPIC_API_KEY=
# Optional model overrides (defaults: router claude-haiku-5-5, worker claude-sonnet-5-5, planner claude-opus-5-5)
SIXXAB_MODEL_ROUTER=
SIXXAB_MODEL_WORKER=
SIXXAB_MODEL_PLANNER=

# Automations: approved actions (posts, messages, campaigns, spend) are handed to this n8n webhook.
# Without it, actions are recorded in the audit log but nothing is sent.
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# Website
BOOKING_URL=https://calendar.app.google/YOUR-BOOKING-PAGE
CONTACT_EMAIL=sunil.kattikar@gmail.com

# Vercel Cron protection for /api/cron-briefing (any long random string)
CRON_SECRET=

# Cost guard: goals per company per 24 hours
DAILY_GOAL_LIMIT=50
